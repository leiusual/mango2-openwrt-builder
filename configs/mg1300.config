CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_glinet_gl-mg1300=y

# Keep a standard LuCI HTTPS interface for network configuration.
CONFIG_PACKAGE_luci-ssl=y

# USB LTE modem: QMI data/control path, netifd integration and LuCI setup.
# uqmi pulls in wwan; qmi-wwan pulls in usb-net and usb-wdm.
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y

# USB modem AT serial ports; device binding is configured after flashing.
# option pulls in kmod-usb-serial and kmod-usb-serial-wwan.
CONFIG_PACKAGE_kmod-usb-serial-option=y
# USB IDs and driver binding diagnostics.
CONFIG_PACKAGE_usbutils=y

# Kernel WireGuard, wg/netifd support and LuCI interface configuration.
# Kconfig resolves crypto, UDP tunnel and LuCI helper dependencies.
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# All other firmware options use upstream/device defaults.
